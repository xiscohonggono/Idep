{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Go API",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/apps/api/main.go",
      "env": {
        "PORT": "8080"
      }
    },
    {
      "name": "Debug Next.js (Web)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter web dev"
    }
  ]
}
